{# roles/coraza/templates/coraza.cfg.j2 #}
# https://github.com/haproxy/haproxy/blob/master/doc/SPOE.txt
# {{ coraza_haproxy_config_dir }}/coraza.cfg
[coraza]
spoe-agent coraza-agent
    # No "messages" directive here on purpose: that auto-fires on
    # "on-frontend-http-request", i.e. before ANY of the frontend's own
    # http-request rules — including a Cloudflare `set-src`, so the WAF
    # would evaluate Cloudflare's edge IP instead of the real client IP.
    # coraza-req is sent explicitly instead, via
    # `http-request send-spoe-group coraza coraza-req` in haproxy_config,
    # placed after `set-src`.
    groups      coraza-req      coraza-res
    option      var-prefix      coraza
    option      set-on-error    error
    timeout     hello           2s
    timeout     idle            2m
    timeout     processing      500ms
    use-backend coraza-spoa
{% if coraza_spoe_log_events %}
    log         global
{% endif %}

spoe-message coraza-req
    # Arguments are required to be in this order
    args app=var(txn.coraza.app) id=unique-id src-ip=src src-port=src_port dst-ip=dst dst-port=dst_port method=method path=path query=query version=req.ver headers=req.hdrs body=req.body
    event on-frontend-http-request

spoe-message coraza-res
    # Arguments are required to be in this order
    args app=var(txn.coraza.app) id=var(txn.coraza.id) version=res.ver status=status headers=res.hdrs body=res.body
    event on-http-response

spoe-group coraza-req
    messages coraza-req

spoe-group coraza-res
    messages coraza-res
