# {{ ansible_managed }}
{% set _aws_id = restic_backup_job.aws_access_key_id | default(restic_aws_access_key_id) %}
{% set _aws_secret = restic_backup_job.aws_secret_access_key | default(restic_aws_secret_access_key) %}
RESTIC_REPOSITORY={{ restic_backup_job.repo_url }}
RESTIC_PASSWORD={{ restic_backup_job.password }}
RESTIC_CACHE_DIR={{ restic_cache_dir }}
{% if _aws_id | length > 0 %}
AWS_ACCESS_KEY_ID={{ _aws_id }}
AWS_SECRET_ACCESS_KEY={{ _aws_secret }}
{% endif %}
{% for entry in restic_backup_job.extra_env | default(restic_extra_env) %}
{{ entry }}
{% endfor %}
