#!/usr/bin/env bash
# {{ ansible_managed }}
# Verify repository integrity. Reads a sampled subset to bound network/io cost.
set -euo pipefail
umask 0077

{% if restic_metrics_textfile_dir | length > 0 %}
METRICS_FILE="{{ restic_metrics_textfile_dir }}/restic_check.prom"
write_metrics() {
  local rc="$1" now tmp
  now=$(date +%s)
  tmp=$(mktemp "${METRICS_FILE}.XXXXXX")
  {
    echo '# HELP restic_check_last_run_timestamp_seconds Unix time of the last restic check run.'
    echo '# TYPE restic_check_last_run_timestamp_seconds gauge'
    echo "restic_check_last_run_timestamp_seconds ${now}"
    echo '# HELP restic_check_last_exit_code Exit code of the last restic check run (0 = success).'
    echo '# TYPE restic_check_last_exit_code gauge'
    echo "restic_check_last_exit_code ${rc}"
    echo '# HELP restic_check_last_success_timestamp_seconds Unix time of the last successful restic check.'
    echo '# TYPE restic_check_last_success_timestamp_seconds gauge'
    if [ "${rc}" -eq 0 ]; then
      echo "restic_check_last_success_timestamp_seconds ${now}"
    elif [ -f "${METRICS_FILE}" ]; then
      grep '^restic_check_last_success_timestamp_seconds' "${METRICS_FILE}" || true
    fi
  } > "${tmp}"
  chmod 0644 "${tmp}"
  mv "${tmp}" "${METRICS_FILE}"
}
trap 'write_metrics $?' EXIT
{% endif %}

restic check --read-data-subset={{ restic_check_read_data_subset | quote }}
