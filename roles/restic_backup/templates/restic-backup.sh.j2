#!/usr/bin/env bash
# {{ ansible_managed }}
# Run a tagged restic backup, then forget+prune per retention policy.
set -euo pipefail
umask 0077

{% if restic_metrics_textfile_dir | length > 0 %}
METRICS_FILE="{{ restic_metrics_textfile_dir }}/restic_backup.prom"
write_metrics() {
  local rc="$1" now tmp
  now=$(date +%s)
  tmp=$(mktemp "${METRICS_FILE}.XXXXXX")
  {
    echo '# HELP restic_backup_last_run_timestamp_seconds Unix time of the last restic backup run.'
    echo '# TYPE restic_backup_last_run_timestamp_seconds gauge'
    echo "restic_backup_last_run_timestamp_seconds{tag=\"{{ restic_snapshot_tag }}\"} ${now}"
    echo '# HELP restic_backup_last_exit_code Exit code of the last restic backup run (0 = success).'
    echo '# TYPE restic_backup_last_exit_code gauge'
    echo "restic_backup_last_exit_code{tag=\"{{ restic_snapshot_tag }}\"} ${rc}"
    echo '# HELP restic_backup_last_success_timestamp_seconds Unix time of the last successful restic backup.'
    echo '# TYPE restic_backup_last_success_timestamp_seconds gauge'
    if [ "${rc}" -eq 0 ]; then
      echo "restic_backup_last_success_timestamp_seconds{tag=\"{{ restic_snapshot_tag }}\"} ${now}"
    elif [ -f "${METRICS_FILE}" ]; then
      grep '^restic_backup_last_success_timestamp_seconds' "${METRICS_FILE}" || true
    fi
  } > "${tmp}"
  chmod 0644 "${tmp}"
  mv "${tmp}" "${METRICS_FILE}"
}
trap 'write_metrics $?' EXIT
{% endif %}

{% if restic_init_if_missing %}
if ! restic --quiet snapshots >/dev/null 2>&1; then
  logger -t restic-backup "repository absent; initialising"
  restic init --quiet
fi
{% endif %}

restic backup \
  --tag {{ restic_snapshot_tag | quote }} \
  --host "$(hostname)" \
{% for ex in restic_exclude_patterns %}
  --exclude {{ ex | quote }} \
{% endfor %}
{% for p in restic_paths %}
  {{ p | quote }} \
{% endfor %}
  --quiet

restic forget \
  --tag {{ restic_snapshot_tag | quote }} \
{% if restic_keep_daily | int > 0 %}
  --keep-daily {{ restic_keep_daily }} \
{% endif %}
{% if restic_keep_weekly | int > 0 %}
  --keep-weekly {{ restic_keep_weekly }} \
{% endif %}
{% if restic_keep_monthly | int > 0 %}
  --keep-monthly {{ restic_keep_monthly }} \
{% endif %}
{% if restic_keep_yearly | int > 0 %}
  --keep-yearly {{ restic_keep_yearly }} \
{% endif %}
  --prune \
  --quiet
