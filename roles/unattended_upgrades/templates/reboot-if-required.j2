#!/bin/sh
# {{ ansible_managed }}
# Started by reboot-if-required.timer at the window start (plus a random delay).
set -eu
umask 022
required_file={{ _unattended_upgrades_reboot_required_file | quote }}
status_dir={{ _unattended_upgrades_reboot_status_dir | quote }}
# The timer's random delay is part of the window, so only what's left of it is ours.
deadline=$(( $(date +%s) + {{ unattended_upgrades_reboot_window_duration_sec | int - unattended_upgrades_reboot_window_random_delay_sec | int }} ))

# The outcome of this window, for monitoring; renamed into place so a reader
# never sees half of it.
record() {
  printf 'time=%s\noutcome=%s\nreason=%s\n' "$(date +%s)" "$1" "$2" > "$status_dir/status.tmp"
  mv -f "$status_dir/status.tmp" "$status_dir/status"
}

# apt-daily-upgrade is Type=oneshot: it reports "activating" while it runs,
# which `systemctl is-active --quiet` counts as not running.
upgrading() {
  case "$(systemctl is-active apt-daily-upgrade.service || true)" in
    active | activating | deactivating | reloading) return 0 ;;
    *) return 1 ;;
  esac
}

condition_holds() {
{% if unattended_upgrades_reboot_window_condition %}
  /bin/sh -c {{ unattended_upgrades_reboot_window_condition | quote }}
{% else %}
  true
{% endif %}
}

# Asked only after the wait: the upgrade it waited for may be what requires
# the reboot.
reboot_required() {
  pkgs=""
  if [ -f "$required_file" ]; then
    required_by="reboot-required file"
    pkgs=$(tr '\n' ' ' < "$required_file.pkgs" 2>/dev/null || true)
{% if unattended_upgrades_reboot_window_trigger %}
  else
    # Exit 0 requires a reboot, 1 does not; anything else (not found, not
    # executable, a signal) means the answer is unknown, which must not read
    # as "no".
    trigger_rc=0
    /bin/sh -c {{ unattended_upgrades_reboot_window_trigger | quote }} || trigger_rc=$?
    case "$trigger_rc" in
      0) required_by="reboot trigger" ;;
      1) return 1 ;;
      *)
        echo "reboot trigger failed (exit $trigger_rc)" >&2
        record skipped "reboot trigger failed (exit $trigger_rc)"
        exit 1
        ;;
    esac
{% else %}
  else
    return 1
{% endif %}
  fi
}

# Rebooting mid-upgrade can leave dpkg half-configured, and the condition
# guards whatever else must not be cut: wait for both, never past the window.
while :; do
  if upgrading; then
    reason="apt-daily-upgrade.service still active"
  elif ! condition_holds; then
    reason="reboot condition not met"
  else
    break
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    # A window that needed no reboot was not skipped, however long it waited.
    if reboot_required; then
      echo "$reason at deadline; reboot skipped"
      record skipped "$reason at deadline"
    else
      record not-required "not required"
    fi
    exit 0
  fi
  sleep 60
done

if ! reboot_required; then
  record not-required "not required"
  exit 0
fi

by=${pkgs:-$required_by}
record rebooting "$required_by"
{% if unattended_upgrades_reboot_window_kexec | bool %}
# Ubuntu links the default kernel in /boot, Debian in /: either points at the
# newest installed kernel, the one a normal boot picks.
for kernel in /boot/vmlinuz /vmlinuz; do
  [ -e "$kernel" ] && break
done
if kexec -l "$kernel" --initrd="${kernel%vmlinuz}initrd.img" --reuse-cmdline; then
  echo "Rebooting via kexec into $(readlink -f "$kernel"), required by: $by"
  systemctl kexec && exit 0
  kexec -u || true
fi
echo "kexec failed; rebooting through the firmware"
{% endif %}
echo "Rebooting, required by: $by"
systemctl reboot
